{
  "name": "dexa-edge",
  "version": "0.1.0",
  "private": true,
  "description": "Dexa control plane + stateful-session orchestration on Cloudflare Workers + Durable Objects, backed by Postgres via Hyperdrive.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "psql \"$DATABASE_URL\" -f schema.sql",
    "typecheck": "tsc --noEmit",
    "seed": "node scripts/seed.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^5.9.3",
    "wrangler": "^3.86.0"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  }
}
