#!/usr/bin/env python3
"""Compatible stand-in for the mini-SWE-agent helper: edit_via_str_replace FILE -- OLD NEW (OLD must occur exactly once)."""
import sys
args = sys.argv[1:]
if "--" in args:
    i = args.index("--"); path = args[0]; old, new = args[i+1], args[i+2] if i+2 < len(args) else ""
else:
    path, old, new = args[0], args[1], (args[2] if len(args) > 2 else "")
text = open(path, encoding="utf-8", errors="replace").read()
n = text.count(old)
if n == 0: print(f"Error: old string not found in {path}"); sys.exit(1)
if n > 1: print(f"Error: old string occurs {n} times in {path}; it must be unique"); sys.exit(1)
open(path, "w", encoding="utf-8").write(text.replace(old, new, 1))
print(f"Replaced 1 occurrence in {path}")
